# Neon / Postgres (preferred for this dashboard)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Fallback: original DigitalOcean MySQL (used only if DATABASE_URL is not set)
MYSQL_HOST=your-db-host.db.ondigitalocean.com
MYSQL_PORT=25060
MYSQL_USER=newgendata
MYSQL_PASSWORD=
MYSQL_DATABASE=newgendata
MYSQL_SSL=true
PORT=3010
CLIENT_ORIGIN=http://localhost:5174
